# App
APP_PORT=8080

# MySQL
MYSQL_PORT=3307
MYSQL_DATABASE=sistema_gestao
MYSQL_USER=root
MYSQL_PASSWORD=1234

# Auth bootstrap (desabilitado por padrao). Use em ambiente novo para criar o primeiro usuario.
# Recomendada: usar AUTH_PASSWORD_HASH para evitar senha em texto claro no ambiente.
# AUTH_BOOTSTRAP_ENABLED=true
# AUTH_USERNAME=
# AUTH_PASSWORD=
# AUTH_PASSWORD_HASH=

# JWT (recomendado): minimo 32 caracteres
# JWT_SECRET=change-me-to-a-very-long-secret-please
